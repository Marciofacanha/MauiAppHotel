<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContrataçãoHospedagem"
             Title="ContrataçãoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    
    <VerticalStackLayout VerticalOptions="Center" Padding="10">
        
        <Label 
            Text="Cálculo da Diária!"
            FontFamily="KalamLight"
            FontSize="50"
            TextColor="{StaticResource Primary}"/>

        <Frame Padding="10">

            <VerticalStackLayout>

                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Adultos:" />


                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>

                    <Stepper Grid.Row="0" Grid.Column="2"
                            x:Name="stp_adultos"
                            Minimum="0"
                            Maximum="10"
                             Increment="1"/>


                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Crianças:" />

                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"/>

                </Grid>

                <Label Text="Escolha sua Suíte" />

                <Picker x:Name="pck_quarto"
                        Title="Selecione sua Acomodação" />

                <Frame Padding="10" Margin="10">

                    <VerticalStackLayout>

                        <Label Text="Periodo da Estadia"/>

                        <HorizontalStackLayout>

                            <Label Text="Check-in" />
                            <DatePicker  x:Name="dtpck_checkin"
                                         Format="dd/mm/yyyy"/>

                        </HorizontalStackLayout>

                        <HorizontalStackLayout>

                            <Label Text="Check-out" />
                            <DatePicker  x:Name="dtpck_checkout"
                                         Format="dd/mm/yyyy"/>

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                
                </Frame>

                <Button Text="Avançar" />

                <Button Text="Sobre" 
                        Margin="0,20,0,0"
                        WidthRequest="100"
                        Clicked="Button_Clicked"
                        />
                <!-- Botão criado para ir a interface criada SOBRE
                     com margin para não grudar no botão avançar e 
                     Widhth para regular largura e no final um 
                     manipulador de eventos-->

            </VerticalStackLayout>
        </Frame>
        
    </VerticalStackLayout>
    
</ContentPage>