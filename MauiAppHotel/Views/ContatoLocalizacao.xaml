<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContatoLocalizacao"
             BackgroundColor="{StaticResource Magenta}"
             Title="Contato e Localização">
    
    
    <VerticalStackLayout Padding="20" Spacing="15">
        
        <Label 
            Text="Fale conosco"
            FontFamily="TinyItalic"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center"/>
        
        <VerticalStackLayout Spacing="10">
            <Label Text="Telefone: (11) 1234-5678" 
                   TextColor="{StaticResource Primary}"
                   FontSize="25"/>
            <Label Text="Email: contato@hotel.com"
                   TextColor="{StaticResource Primary}"
                   FontSize="20"/>
            <Label Text="Atendimento: 24 horas"
                   HorizontalOptions="Center"
                   FontFamily="Kalam"/>
        </VerticalStackLayout>
        
        <VerticalStackLayout Spacing="10">
            <Label Text="Localização"
                   FontFamily="TinyItalic"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <Label Text="Rua Desenvolvimento de Sistema N: 14" 
                   FontSize="18"
                   FontFamily="Kalam"/>
            <Label Text="CEP: 12345-678" 
                   HorizontalOptions="Center"/>
            <Label Text="Cidade: São Paulo - SP" 
                   HorizontalOptions="Center"/>
            
            <Button Text="Abrir no Google Maps"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    HorizontalOptions="Center"/>
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>